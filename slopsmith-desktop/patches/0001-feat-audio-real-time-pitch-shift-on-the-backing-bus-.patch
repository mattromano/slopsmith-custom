diff --git a/src/audio/BackingPitchShifter.cpp b/src/audio/BackingPitchShifter.cpp
new file mode 100644
index 0000000..b31a216
--- /dev/null
+++ b/src/audio/BackingPitchShifter.cpp
@@ -0,0 +1,98 @@
+#include "BackingPitchShifter.h"
+
+// signalsmith-stretch is header-only and pulls in its bundled dsp/ headers via
+// relative includes; the include dir is wired in src/audio/CMakeLists.txt.
+#include "signalsmith-stretch.h"
+
+#include <atomic>
+#include <cmath>
+#include <limits>
+
+struct BackingPitchShifter::Impl
+{
+    signalsmith::stretch::SignalsmithStretch<float> stretch;
+    juce::AudioBuffer<float> scratch;     // distinct output (process() isn't in-place)
+    int    channels   = 0;
+    double sampleRate = 0.0;
+    int    maxBlock   = 0;
+    int    latency    = 0;
+    bool   configured = false;
+
+    std::atomic<float> semitones{0.0f};   // target (written off-thread, read on RT)
+    float  appliedSemitones = 0.0f;       // last value pushed to the stretcher (RT only)
+};
+
+BackingPitchShifter::BackingPitchShifter() : impl(std::make_unique<Impl>()) {}
+BackingPitchShifter::~BackingPitchShifter() = default;
+
+void BackingPitchShifter::prepare(int numChannels, double sampleRate, int maxBlockSamples)
+{
+    if (numChannels < 1) numChannels = 1;
+    impl->channels   = numChannels;
+    impl->sampleRate = sampleRate;
+    impl->maxBlock   = juce::jmax(1, maxBlockSamples);
+
+    // presetDefault: ~120 ms analysis window — good music quality. Latency is
+    // inputLatency()+outputLatency() == one window; exposed via latencyMs() so
+    // the renderer can keep the chart aligned with the delayed audio.
+    impl->stretch.presetDefault(numChannels, static_cast<float>(sampleRate));
+    impl->latency = impl->stretch.inputLatency() + impl->stretch.outputLatency();
+
+    impl->scratch.setSize(numChannels, impl->maxBlock, false, false, true);
+    impl->stretch.reset();
+    impl->appliedSemitones = std::numeric_limits<float>::quiet_NaN(); // force re-push
+    impl->configured = true;
+}
+
+void BackingPitchShifter::reset()
+{
+    if (impl->configured) impl->stretch.reset();
+}
+
+void BackingPitchShifter::setSemitones(float semitones)
+{
+    impl->semitones.store(semitones, std::memory_order_relaxed);
+}
+
+float BackingPitchShifter::getSemitones() const
+{
+    return impl->semitones.load(std::memory_order_relaxed);
+}
+
+bool BackingPitchShifter::isActive() const
+{
+    return impl->configured
+        && std::abs(impl->semitones.load(std::memory_order_relaxed)) > 1.0e-4f;
+}
+
+int    BackingPitchShifter::numChannels()    const { return impl->channels; }
+int    BackingPitchShifter::latencySamples() const { return impl->configured ? impl->latency : 0; }
+
+double BackingPitchShifter::latencyMs() const
+{
+    return (impl->configured && impl->sampleRate > 0.0)
+        ? 1000.0 * impl->latency / impl->sampleRate
+        : 0.0;
+}
+
+void BackingPitchShifter::process(juce::AudioBuffer<float>& buffer, int numSamples)
+{
+    if (!impl->configured) return;
+
+    const float semis = impl->semitones.load(std::memory_order_relaxed);
+    if (std::abs(semis) <= 1.0e-4f) return;                 // bypass
+    if (buffer.getNumChannels() != impl->channels) return;  // channel-count guard
+    if (numSamples <= 0 || numSamples > impl->maxBlock) return; // size guard (no RT alloc)
+
+    if (!(semis == impl->appliedSemitones)) {               // != also catches the NaN sentinel
+        impl->stretch.setTransposeSemitones(semis);
+        impl->appliedSemitones = semis;
+    }
+
+    // Equal input/output sample counts ⇒ playback rate 1.0 ⇒ tempo preserved,
+    // only the transpose applies. signalsmith wants a distinct output buffer.
+    impl->stretch.process(buffer.getArrayOfReadPointers(),  numSamples,
+                          impl->scratch.getArrayOfWritePointers(), numSamples);
+    for (int ch = 0; ch < impl->channels; ++ch)
+        buffer.copyFrom(ch, 0, impl->scratch, ch, 0, numSamples);
+}
diff --git a/src/audio/BackingPitchShifter.h b/src/audio/BackingPitchShifter.h
new file mode 100644
index 0000000..b49c0c9
--- /dev/null
+++ b/src/audio/BackingPitchShifter.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <juce_audio_basics/juce_audio_basics.h>
+#include <memory>
+
+// Real-time, tempo-preserving pitch shifter for the backing-track bus
+// (Auto-Tuner / Live Retune, deliverable B). Wraps signalsmith-stretch (MIT,
+// header-only) behind a pImpl so the heavy template header is confined to one
+// translation unit (BackingPitchShifter.cpp).
+//
+// Threading contract:
+//   - prepare() / reset() ALLOCATE and configure — call off the audio thread
+//     (device-start hook, song load, seek). They take no locks themselves; the
+//     caller serialises them against process() via the existing backingLock.
+//   - setSemitones() / process() are real-time safe (no allocation, no locks).
+//
+// process() introduces an algorithmic latency of ~one analysis window
+// (latencySamples()); callers that drive a visual playhead should compensate by
+// that amount while a non-zero shift is active so audio and chart stay aligned.
+class BackingPitchShifter
+{
+public:
+    BackingPitchShifter();
+    ~BackingPitchShifter();
+
+    // (Re)configure for this device. Allocates — off the audio thread only.
+    void prepare(int numChannels, double sampleRate, int maxBlockSamples);
+
+    // Drop buffered audio (call on seek / track change). Off the audio thread.
+    void reset();
+
+    // RT-safe: target shift in semitones. 0 = bypass (process() becomes a no-op).
+    void setSemitones(float semitones);
+    float getSemitones() const;
+
+    // True when configured AND a non-zero shift is set.
+    bool isActive() const;
+    int numChannels() const;
+
+    // Algorithmic latency: output lags input by ~one analysis window.
+    int latencySamples() const;
+    double latencyMs() const;
+
+    // RT-safe: pitch-shift `buffer` in place over its first `numSamples` frames.
+    // No-op when inactive, or on a channel-count / block-size mismatch (so we
+    // never allocate or read out of bounds on the audio thread).
+    void process(juce::AudioBuffer<float>& buffer, int numSamples);
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl;
+};
