--- a/src/audio/AudioEngine.cpp
+++ b/src/audio/AudioEngine.cpp
@@ -472,6 +472,10 @@ void AudioEngine::setBackingPosition(double seconds)
     if (backingTransport)
     {
         backingTransport->setPosition(seconds);
+        // Drop the shifter's buffered audio so a seek doesn't bleed
+        // pitch-shifted content from the old position. Safe here: the callback
+        // takes backingLock via ScopedTryLock, so it can't run concurrently.
+        backingPitch.reset();
         // Read back the actual position; the transport may clamp (e.g. negative or past EOF).
         cachedBackingPosition.store(backingTransport->getCurrentPosition());
     }
@@ -502,6 +506,15 @@ void AudioEngine::stopBacking()
     stopBackingNoLock();
 }
 
+void AudioEngine::setBackingPitchSemitones(float semitones)
+{
+    // Lock-free: an atomic mirror for getBackingPitchSemitones() + re-assert on
+    // device start, plus the shifter's own RT-safe atomic. Callable from the
+    // IPC/JS thread without touching backingLock or the audio callback.
+    backingPitchSemitones.store(semitones, std::memory_order_relaxed);
+    backingPitch.setSemitones(semitones);
+}
+
 void AudioEngine::resetPeaks()
 {
     inputPeak.store(0.0f);
@@ -549,6 +562,14 @@ void AudioEngine::audioDeviceAboutToStart(juce::AudioIODevice* device)
     noiseGate.prepare(sr, bs);
     tonePolish.prepare(sr);
 
+    // Configure the live-retune shifter for this device (allocates — fine on
+    // the device-start thread). Match the output channel count the callback
+    // fills the backing buffer with, then re-assert the current shift.
+    int backingOutCh = device->getActiveOutputChannels().countNumberOfSetBits();
+    if (backingOutCh < 1) backingOutCh = 2;
+    backingPitch.prepare(backingOutCh, sr, bs);
+    backingPitch.setSemitones(backingPitchSemitones.load(std::memory_order_relaxed));
+
     const juce::ScopedLock sl(backingLock);
     if (backingTransport)
         backingTransport->prepareToPlay(bs, sr);
@@ -758,10 +779,24 @@ void AudioEngine::audioDeviceIOCallbackWithContext(
             juce::AudioSourceChannelInfo info(&backingBuffer, 0, numSamples);
             backingTransport->getNextAudioBlock(info);
 
+            // Live retune: pitch-shift the backing block in place before it's
+            // mixed. No-op (early return) when the shift is 0, so normal
+            // playback stays bit-untouched and zero-latency.
+            backingPitch.process(backingBuffer, numSamples);
+
             // Keep cached position and playing state up to date for lock-free polling.
             // backingTransport is non-null (checked above) and backingLock is held for
-            // this entire block via ScopedTryLock, so these reads are safe.
-            cachedBackingPosition.store(backingTransport->getCurrentPosition());
+            // this entire block via ScopedTryLock, so these reads are safe. While a
+            // shift is active the audio coming out of the shifter lags the transport
+            // by its latency, so report the delayed position to keep the chart
+            // playhead aligned with what's actually heard.
+            double reportedBackingPos = backingTransport->getCurrentPosition();
+            if (backingPitch.isActive())
+            {
+                reportedBackingPos -= backingPitch.latencyMs() / 1000.0;
+                if (reportedBackingPos < 0.0) reportedBackingPos = 0.0;
+            }
+            cachedBackingPosition.store(reportedBackingPos);
 
             // Sync the flag if transport stopped at EOF
             if (!backingTransport->isPlaying())
